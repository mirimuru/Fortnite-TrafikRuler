<Window x:Class="FortniteTrafficRuler.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Fortnite Traffic Ruler" Height="650" Width="1050"
        MinHeight="500" MinWidth="820"
        Background="#FF111827" Foreground="#FFF3F4F6"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Fortnite Traffic Ruler" FontSize="26" FontWeight="SemiBold"/>
                <TextBlock Text="ネットワーク通信監視・振り分けツール" Foreground="#FF9CA3AF" Margin="0,5,0,0"/>
            </StackPanel>
            <Border DockPanel.Dock="Right" Background="#FF174B36" CornerRadius="12" Padding="12,6" VerticalAlignment="Center">
                <TextBlock Text="監視モード" Foreground="#FF86EFAC" FontWeight="SemiBold"/>
            </Border>
        </DockPanel>

        <UniformGrid Grid.Row="1" Columns="2" Margin="0,0,0,18">
            <Border Background="#FF1E3A5F" CornerRadius="10" Padding="16" Margin="0,0,8,0">
                <StackPanel>
                    <TextBlock Text="受信合計速度" Foreground="#FFBFDBFE"/>
                    <TextBlock x:Name="ReceiveTotalText" Text="0.00 Mbps" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
            <Border Background="#FF164E3B" CornerRadius="10" Padding="16" Margin="8,0,0,0">
                <StackPanel>
                    <TextBlock Text="送信合計速度" Foreground="#FFA7F3D0"/>
                    <TextBlock x:Name="SendTotalText" Text="0.00 Mbps" FontSize="25" FontWeight="SemiBold" Margin="0,5,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="2" Background="#FF1F2937" CornerRadius="12" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ネットワークアダプター" FontSize="17" FontWeight="SemiBold" Margin="0,0,0,12"/>
                <DataGrid x:Name="AdaptersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          CanUserAddRows="False" HeadersVisibility="Column"
                          Background="#FF1F2937" Foreground="#FFF3F4F6"
                          RowBackground="#FF273449" AlternatingRowBackground="#FF202D40"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          HorizontalGridLinesBrush="#FF374151"
                          ColumnHeaderStyle="{DynamicResource {x:Type DataGridColumnHeader}}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="アダプター" Binding="{Binding Name}" Width="2*"/>
                        <DataGridTextColumn Header="種類" Binding="{Binding Kind}" Width="*"/>
                        <DataGridTextColumn Header="状態" Binding="{Binding Status}" Width="*"/>
                        <DataGridTextColumn Header="受信速度" Binding="{Binding ReceiveMbps, StringFormat={}{0:F2} Mbps}" Width="*"/>
                        <DataGridTextColumn Header="送信速度" Binding="{Binding SendMbps, StringFormat={}{0:F2} Mbps}" Width="*"/>
                        <DataGridTextColumn Header="リンク速度" Binding="{Binding LinkSpeedMbps, StringFormat={}{0:F0} Mbps}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>

        <TextBlock Grid.Row="3" Text="現在はアダプター単位の通信量を監視しています。通信経路の変更は行いません。"
                   Foreground="#FFFBBF24" TextWrapping="Wrap" Margin="2,14,2,0"/>
    </Grid>
</Window>
